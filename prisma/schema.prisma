generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         String   @default("PILOT")
  rank         String   @default("D")
  wins         Int      @default(0)
  losses       Int      @default(0)
  consecutiveWins Int @default(0)
  profilePhoto String?
  locality     String?
  city         String?
  state        String?
  country      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vehicles           Vehicle[]
  challengesSent     Challenge[] @relation("ChallengeChallenger")
  challengesReceived Challenge[] @relation("ChallengeChallenged")

  @@map("users")
}

model Vehicle {
  id            String   @id @default(uuid())
  userId        String
  vehicleType   String
  brand         String
  model         String
  year          Int
  color         String
  plate         String?  @unique
  photo         String?
  modifications String?
  active        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, active])
  @@map("vehicles")
}

model Challenge {
  id                  String    @id @default(uuid())
  challengerId        String
  challengedId        String
  raceType            String
  challengerVehicleId String
  challengedVehicleId String?
  status              String    @default("pending")
  winnerId            String?
  agreedLocation      String?
  agreedDate          DateTime?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  challenger User @relation("ChallengeChallenger", fields: [challengerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  challenged User @relation("ChallengeChallenged", fields: [challengedId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([challengerId])
  @@index([challengedId])
  @@index([status])
  @@map("challenges")
}
