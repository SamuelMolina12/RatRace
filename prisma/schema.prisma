generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  email         String   @unique
  passwordHash  String   @map("password_hash")
  role          String   @default("PILOT")
  rango         String   @default("D")
  victorias     Int      @default(0)
  derrotas      Int      @default(0)
  fotoPerfil    String?  @map("foto_perfil")
  zonaLocalidad String?  @map("zona_localidad")
  zonaCiudad    String?  @map("zona_ciudad")
  zonaEstado    String?  @map("zona_estado")
  zonaPais      String?  @map("zona_pais")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  @@map("users")
}