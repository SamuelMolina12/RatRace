generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         String   @default("PILOT")
  rank         String   @default("D")
  wins         Int      @default(0)
  losses       Int      @default(0)
  profilePhoto String?
  locality     String?
  city         String?
  state        String?
  country      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@map("users")
}